# ==============================================================================
# Конфигурация «Авито-Перехватчика» (Нейро-студия)
# Скопируйте этот файл в .env и заполните своими значениями
# ==============================================================================

# 1. Telegram: Токен бота от @BotFather (например: 7123456789:AAH_xxx)
TELEGRAM_BOT_TOKEN=

# 2. Telegram: Ваш персональный числовой ID (узнать в @userinfobot или @getmyid_bot)
TELEGRAM_CHAT_ID=

# 3. Авито API: Ключи из личного кабинета https://www.avito.ru/professionals/api
# Важно: при создании ключа выберите права на «Сообщения»
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=

# 4. Авито API: Числовой ID вашего профиля (указан в том же кабинете API)
AVITO_USER_ID=

# 5. Настройки мгновенного автоответа
AUTO_REPLY_ENABLED=true
AUTO_REPLY_TEXT=Здравствуйте! 👋 Спасибо за обращение. Ваше сообщение принято, мастер/менеджер свяжется с вами в течение 3–5 минут.
