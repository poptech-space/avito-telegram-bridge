{
  "name": "avito-telegram-bridge",
  "version": "1.0.0",
  "description": "Avito ↔ Telegram: защищённый webhook и управляемая доставка на YCF + YDB",
  "main": "index.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/poptech-space/avito-telegram-bridge.git"
  },
  "scripts": {
    "test": "node scripts/verify-core.js && node test/run-mock.js && node --test test/*.test.cjs",
    "deploy": "./deploy.sh",
    "ping": "node scripts/test-live-ping.js",
    "register:tg": "node scripts/register-telegram-webhook.js",
    "register:avito": "node scripts/register-avito-webhook.js",
    "emulator": "node scripts/emulator.js",
    "simulate": "node scripts/simulate-webhook.js",
